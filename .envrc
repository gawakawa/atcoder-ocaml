use flake .

# Point acc's global config dir at this worktree's acc-config/, so multiple
# worktrees never share (and clobber) one dangling symlink.
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/atcoder-cli-nodejs"
if [ -e "$CONFIG_DIR" ] && [ ! -L "$CONFIG_DIR" ]; then
  echo "acc-config: $CONFIG_DIR is a real directory; remove it and reload direnv" >&2
  exit 1
fi
mkdir -p "$(dirname "$CONFIG_DIR")"
ln -sfn "$PWD/acc-config" "$CONFIG_DIR"

# The AtCoder session, on the other hand, is shared across worktrees so
# `aclogin` only needs to run once per machine.
ACC_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/atcoder-ocaml"
mkdir -p "$ACC_STATE_DIR"
if [ -f "$PWD/acc-config/session.json" ] && [ ! -L "$PWD/acc-config/session.json" ]; then
  if [ -e "$ACC_STATE_DIR/session.json" ]; then
    echo "acc-config: $ACC_STATE_DIR/session.json already exists and $PWD/acc-config/session.json is a real, un-migrated file; resolve manually and reload direnv" >&2
    exit 1
  fi
  mv "$PWD/acc-config/session.json" "$ACC_STATE_DIR/session.json"
fi
ln -sfn "$ACC_STATE_DIR/session.json" "$PWD/acc-config/session.json"
