opam-version: "2.0"
synopsis: "AtCoder OCaml environment"
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.0"}
  "batteries" {= "3.9.0"}
  "containers" {= "3.16"}
  "core" {= "v0.17.1"}
  "core_bench" {= "v0.17.0"}
  "core_unix" {= "v0.17.1"}
  "iter" {= "1.9"}
  "num" {= "1.6"}
  "zarith" {= "1.14"}
