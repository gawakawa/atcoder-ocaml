{
  "permissions": {
    "ask": [
      "Edit(contests/**)",
      "Edit(README.md)",
      "Edit(CLAUDE.md)",
      "Edit(CONTRIBUTING.md)",
      "Edit(docs/**)",
      "Write(README.md)",
      "Write(CLAUDE.md)",
      "Write(CONTRIBUTING.md)",
      "Write(docs/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR} && nix flake check"
          }
        ]
      }
    ]
  }
}
